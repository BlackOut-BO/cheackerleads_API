# Веб-версия чекера лидов. Ключи — ОТДЕЛЬНЫЕ от боевого бота (свои аккаунты/лимиты).
# TELEGRAM_BOT_TOKEN не нужен и не указывается: второй экземпляр с боевым токеном сломает бота.
# Без ключа соответствующая проверка возвращает «API key not configured», остальные работают.

# Email — Abstract API (Email Reputation)
ABSTRACT_API_KEY=
# IP — ipdata.co
IPDATA_API_KEY=
# Телефон — numverify (apilayer)
NUMVERIFY_API_KEY=
# WhatsApp и соцсети — RapidAPI
RAPIDAPI_KEY=
WHATSAPP_API_HOST=
FACEBOOK_API_HOST=
GOOGLE_API_HOST=
INSTAGRAM_API_HOST=
SNAPCHAT_API_HOST=
X_API_HOST=
# Включить проверку WhatsApp (true/false), провайдер
ENABLE_WHATSAPP_CHECK=
WHATSAPP_API_PROVIDER=
CHECKNUMBER_API_KEY=
# Прокси для WhatsApp-проверок (socks5://user:pass@host:port или http://…)
PROXY_URL=

# Веб: кто видит журнал действий всех пользователей (id из панели через запятую)
LEADS_ADMIN_IDS=
# Путь к SQLite веба (по умолчанию data/buying.db)
BUYING_DB=
